# Stránky cvf.cz procházejí proxy /cvf/* na stejné doméně jako aplikace.
# Aplikace z nich čte jen text; prohlížeč je nesmí vykreslit jako stránku se skripty,
# která by měla přístup k uloženým zápasům (sandbox = izolovaný původ, žádné skripty).
/cvf/*
  Content-Security-Policy: sandbox; default-src 'none'
  X-Content-Type-Options: nosniff
  Cache-Control: no-store

/
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/soukromi.html
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()

